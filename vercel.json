{
  "version": 2,
  "regions": ["iad1"],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "storage/**"
    }
  },
  "rewrites": [
    { "source": "/animemoe", "destination": "/api/animemoe" },
    { "source": "/tts", "destination": "/api/tts" },
    { "source": "/status", "destination": "/api/status" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/warm", "destination": "/api/warm" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
